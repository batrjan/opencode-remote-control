# Copy to /opt/opencode-remote-control/.env on the host (owner-only, chmod 600).
# The deploy workflow creates the file and generates RELAY_STATE_KEY on its
# first run, so a fresh host needs nothing here.

# Port the relay listens on (must match the host nginx proxy_pass target).
# PORT=8080

# Encrypts the persisted session state (AES-256-GCM). Keep it OUT of the state
# volume: with it, join codes survive a redeploy and a copied volume is useless
# without the key. Generate with: openssl rand -hex 32
# RELAY_STATE_KEY=

# Where the session set is persisted inside the container (compose mounts a
# named volume there). Empty = in-memory only.
# RELAY_STATE_FILE=/data/state.json

# Which proxy hop to trust for X-Forwarded-For (express `trust proxy`). In
# Docker the nginx hop arrives from the bridge gateway (172.x), so the compose
# default is "loopback, uniquelocal". See DEPLOY.md.
# RELAY_TRUST_PROXY=loopback, uniquelocal

# Most shares the relay holds at once. A full relay makes room by ending the
# share whose bridge has been gone longest (over 5 minutes), and refuses new
# shares with 503 only when there is none; both are logged. See DEPLOY.md.
# RELAY_MAX_SESSIONS=2000

# DoS bounds on response buffering. The first caps the largest single frame a
# bridge may send (a larger frame is rejected before it is buffered, and it is
# also the ceiling a compressed body may inflate to). It defaults to the 100 MiB
# the bridge protocol allows: lower it only for an install whose own bridges are
# known to stay under the new value, because a frame over it costs that bridge
# its link, not just the request. The second caps the total response bytes the
# proxy path holds for slow/non-reading viewers at once: over it, a new request
# gets 503 rather than being buffered. It is never below eight of the first, so
# lowering the frame cap is what tightens it.
# RELAY_BRIDGE_MAX_PAYLOAD_BYTES=104857600
# RELAY_PROXY_MAX_BUFFERED_BYTES=134217728

# Artificial delay (ms) before rejecting a wrong access code. Spec default: 1000.
# Set to 0 only in tests.
# ACTIVATE_FAIL_DELAY_MS=1000

# Image to run. The deploy builds relay-local:amd64 on the host and tags the
# previous one relay-local:rollback-<stamp>; set this to roll back.
# RELAY_IMAGE=relay-local:amd64

# NOTE: no API key is needed. Session registration is public (rate-limited per
# client IP); deleting a session requires its own bridge_token, issued at
# registration. RELAY_API_KEY is accepted for old bridges and ignored.
