# Port the relay listens on (must match the host nginx proxy_pass target).
# PORT=8080

# Artificial delay (ms) before rejecting a wrong access code. Spec default: 1000.
# Set to 0 only in tests.
# ACTIVATE_FAIL_DELAY_MS=1000

# NOTE: no API key needed. Session registration is public (rate-limited per IP);
# deleting a session requires its own bridge_token, issued at registration.

# Image to deploy (defaults to ghcr.io/<owner>/opencode-remote-control/relay:latest).
# RELAY_IMAGE=ghcr.io/<owner>/opencode-remote-control/relay:latest
