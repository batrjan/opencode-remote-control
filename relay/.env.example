# Shared secret the bridge sends as x-api-key for the session-management API.
# Generate with: openssl rand -hex 32
RELAY_API_KEY=change-me

# Port the relay listens on (must match the host nginx proxy_pass target).
# PORT=8080

# Image to deploy (defaults to ghcr.io/anomalyco/opencode-remote-control/relay:latest).
# RELAY_IMAGE=ghcr.io/<owner>/opencode-remote-control/relay:latest
